@model IEnumerable<Library_Management.Models.Author>

@{
    ViewData["Title"] = "Archived Authors";
}

<h2>Archived Authors</h2>

<p>
    <a asp-action="Index" class="btn btn-primary">
        <i class="bi bi-arrow-left"></i> Back to Authors
    </a>
</p>

@if (Model.Any())
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Profile</th>
                <th>Name</th>
                <th>Birthdate</th>
                <th>Books</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var author in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(author.ProfileImageUrl))
                        {
                            <img src="@author.ProfileImageUrl" alt="@author.Name"
                                 class="rounded-circle"
                                 style="width:40px; height:40px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center"
                                 style="width:40px; height:40px;">
                                <i class="bi bi-person text-white"></i>
                            </div>
                        }
                    </td>
                    <td>@author.Name</td>
                    <td>@author.BirthDate.ToString("yyyy-MM-dd")</td>
                    <td>@author.Books.Count</td>
                    <td>
                        <a asp-action="Restore" asp-route-id="@author.AuthorId"
                           class="btn btn-success btn-sm">
                            <i class="bi bi-arrow-counterclockwise"></i> Restore
                        </a>
                        <a asp-action="Details" asp-route-id="@author.AuthorId"
                           class="btn btn-info btn-sm">
                            <i class="bi bi-eye"></i> Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        <h4>No Archived Authors</h4>
        <p>There are currently no archived authors.</p>
    </div>
}
