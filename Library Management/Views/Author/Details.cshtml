@model Library_Management.Models.Author
@using System.Linq

@{
    ViewData["Title"] = "Author Details";
}

<h2>@Model.Name</h2>

<div class="row">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
        {
            <img src="@Model.ProfileImageUrl" class="img-fluid rounded shadow-sm" alt="@Model.Name" />
        }
    </div>
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">Biography</dt>
            <dd class="col-sm-9">@Model.Biography</dd>

            <dt class="col-sm-3">Birthdate</dt>
            <dd class="col-sm-9">@Model.BirthDate.ToString("yyyy-MM-dd")</dd>
        </dl>
    </div>
</div>

<hr />

<h4>Books by @Model.Name</h4>
@{
    var bookService = BookService.Instance;
    var books = bookService.GetBooks(includeArchived: true)
        .Where(b => b.AuthorName?.Equals(Model.Name, StringComparison.OrdinalIgnoreCase) == true)
        .ToList();
}

@if (books.Any())
{
    <div class="row">
        @foreach (var book in books)
        {
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                    {
                        <img src="@book.CoverImageUrl" class="card-img-top" alt="@book.Title" style="height: 200px; object-fit: cover;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@book.Title</h5>
                        <p class="card-text text-muted">@book.Genre</p>
                        @if (book.PublishedDate.HasValue)
                        {
                            <p class="card-text"><small class="text-muted">Published: @book.PublishedDate.Value.ToString("yyyy")</small></p>
                        }
                        @if (book.IsArchived)
                        {
                            <span class="badge bg-warning mb-2">Archived</span>
                        }
                        <div class="mt-auto">
                            <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId" class="btn btn-primary btn-sm">
                                <i class="bi bi-eye"></i> View Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        <h5><i class="bi bi-info-circle"></i> No Books Found</h5>
        <p>This author currently has no books in our library system.</p>
    </div>
}

<p class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>
