@model IEnumerable<Library_Management.Models.BookListViewModel>

@{
    ViewData["Title"] = "Archived Books";
}

<h2>Archived Books</h2>

<p>
    <a asp-action="Index" class="btn btn-primary">
        <i class="bi bi-arrow-left"></i> Back to Books
    </a>
</p>

@if (Model.Any())
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Cover</th>
                <th>Title</th>
                <th>Author</th>
                <th>Genre</th>
                <th>ISBN</th>
                <th>Published</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>
                        <img src="@book.CoverImageUrl" alt="@book.Title" style="width:50px;height:auto;" />
                    </td>
                    <td>@book.Title</td>
                    <td>@book.AuthorName</td>
                    <td>@book.Genre</td>
                    <td>@book.ISBN</td>
                    <td>@book.PublishedDate?.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-action="Restore" asp-route-id="@book.BookId"
                           class="btn btn-success btn-sm">
                            <i class="bi bi-arrow-counterclockwise"></i> Restore
                        </a>
                        <a asp-action="Details" asp-route-id="@book.BookId"
                           class="btn btn-info btn-sm">
                            <i class="bi bi-eye"></i> View
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        <h4>No Archived Books</h4>
        <p>There are currently no archived books.</p>
    </div>
}
