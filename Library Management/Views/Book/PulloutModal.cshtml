@model Library_Management.Models.PulloutBookCopyViewModel

<div class="modal fade" id="pulloutModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ConfirmPullout" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Pull Out Book Copy</h5>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="CopyId" />
                    <div class="form-group">
                        <label>Reason</label>
                        <input asp-for="PulloutReason" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>
